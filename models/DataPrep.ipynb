    "from pathlib import Path\n",
    "\n",
    "raw=Path(r\"../datasets/asl_raw\")\n",
    "\n",
    "for folder in sorted(p for p in raw.rglob(\"*\") if p.is_dir()):\n",
    "    n = len([f for f in folder.iterdir() if f.suffix.lower() in {\".jpg\", \".jpeg\", \".png\"}])\n",
    "    if n:\n",
    "        print(folder.relative_to(raw), n)"
   ]
